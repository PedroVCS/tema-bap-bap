    "featured_products_1": {
      "type": "product-list",
      "settings": {
        "section_width": "page",
        "gap": 20,
        "vertical_padding": 8,
        "alignment": "left",
        "custom_css": "\n/* BOTÃO COMPRAR - PRODUTOS EM DESTAQUE */\n\n/* Estilo padrão do botão */\n.js-product-item .js-addtocart,\n.product-item .js-addtocart,\n.product-item__add-to-cart {\n    background-color: #16a34a !important;\n    color: #ffffff !important;\n    border: none !important;\n    border-radius: 5px !important;\n    transition: all 0.3s ease !important;\n}\n\n/* Esconde o botão inicialmente */\n.js-product-item .js-addtocart,\n.product-item .js-addtocart,\n.product-item__add-to-cart {\n    opacity: 0 !important;\n    visibility: hidden !important;\n    pointer-events: none !important;\n    transform: translateY(8px);\n}\n\n/* Desktop: aparece ao passar o mouse */\n@media (min-width: 768px) {\n    .js-product-item:hover .js-addtocart,\n    .product-item:hover .js-addtocart,\n    .product-item:hover .product-item__add-to-cart {\n        opacity: 1 !important;\n        visibility: visible !important;\n        pointer-events: auto !important;\n        transform: translateY(0);\n    }\n}\n\n/* Mobile: aparece ao tocar/interagir com o produto */\n@media (max-width: 767px) {\n    .js-product-item:focus-within .js-addtocart,\n    .product-item:focus-within .js-addtocart,\n    .product-item:focus-within .product-item__add-to-cart,\n    .js-product-item:active .js-addtocart,\n    .product-item:active .js-addtocart {\n        opacity: 1 !important;\n        visibility: visible !important;\n        pointer-events: auto !important;\n        transform: translateY(0);\n    }\n}\n\n/* Efeito ao passar o mouse sobre o botão */\n.js-addtocart:hover,\n.product-item__add-to-cart:hover {\n    background-color: #15803d !important;\n    color: #ffffff !important;\n}\n"
      },
