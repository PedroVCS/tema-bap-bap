        "columns_mobile": "1",
        "background_color": "#ffffff",
        "custom_css": "\n/* VITRINE BAP & BAP */\n\n.banner,\n.banner img,\n.banner-item,\n.swiper-slide img {\n    transition: all .4s ease !important;\n}\n\n/* Banners */\n.banner img,\n.banner-item img,\n.swiper-slide img {\n    border-radius: 12px;\n    transition: transform .45s ease,\n                filter .45s ease,\n                box-shadow .45s ease !important;\n}\n\n/* Efeito ao passar o mouse */\n@media (hover: hover) and (pointer: fine) {\n    .banner:hover img,\n    .banner-item:hover img,\n    .swiper-slide:hover img {\n        transform: scale(1.035);\n        filter: brightness(1.06);\n        box-shadow: 0 12px 28px rgba(83, 0, 120, .22);\n    }\n}\n\n/* Efeito para celular */\n@media (hover: none) and (pointer: coarse) {\n    .banner:active img,\n    .banner-item:active img,\n    .swiper-slide:active img {\n        transform: scale(.96);\n        filter: brightness(.85);\n    }\n}\n\n/* Suavidade geral */\n.banner,\n.banner-item,\n.swiper-slide {\n    overflow: hidden;\n    border-radius: 12px;\n}\n",
        "format": "slider"
      },
